{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "outDir": "./dist",
    "baseUrl": "./",
    "strictPropertyInitialization": false,
    "noUnusedParameters": false,
    "noUnusedLocals": false,
    "types": ["node", "jest", "multer"]
