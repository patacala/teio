# =============================================================================
# AI Omnichannel CRM - Environment Variables
# Copy to .env and fill in values
# =============================================================================

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# API Service (apps/api)
# -----------------------------------------------------------------------------
API_PORT=3001
API_PREFIX=api

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRATION=7d

# -----------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crm_dev
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=crm_dev
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Supabase (production)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# pgBouncer connection pooling (production)
DATABASE_POOL_URL=postgresql://postgres:postgres@localhost:6432/crm_dev

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# RabbitMQ
# -----------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_VHOST=/

# -----------------------------------------------------------------------------
# AI Providers
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=your-anthropic-key
GOOGLE_AI_API_KEY=your-google-ai-key

# -----------------------------------------------------------------------------
# Channel Integrations
# -----------------------------------------------------------------------------
# WhatsApp (Meta Business API)
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_APP_SECRET=your-app-secret

# Twilio (SMS / Voice)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Email (SendGrid)
SENDGRID_API_KEY=SG.your-sendgrid-key
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=CRM System

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_APP_TOKEN=xapp-your-slack-app-token

# Instagram / Facebook
INSTAGRAM_ACCESS_TOKEN=your-instagram-access-token
FACEBOOK_PAGE_ACCESS_TOKEN=your-facebook-page-token
FACEBOOK_APP_SECRET=your-facebook-app-secret

# -----------------------------------------------------------------------------
# Web Service (apps/web)
# -----------------------------------------------------------------------------
# Host ports (docker compose maps 4000→web, 4001→api; containers still listen on 3000/3001)
WEB_HOST_PORT=4000
API_HOST_PORT=4001

NEXT_PUBLIC_API_URL=http://localhost:4001
NEXT_PUBLIC_WEB_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_WS_URL=ws://localhost:4001

# -----------------------------------------------------------------------------
# Webhooks
# -----------------------------------------------------------------------------
WEBHOOK_SECRET=your-webhook-signing-secret
# URL pública del API (callbacks n8n, webhooks). Local: 3001. Prod: https://api.prosalesia.com
BASE_URL=http://localhost:3001

# -----------------------------------------------------------------------------
# Storage (Supabase Storage / S3)
# -----------------------------------------------------------------------------
STORAGE_BUCKET=crm-media
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket

# -----------------------------------------------------------------------------
# Monitoring & Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
SENTRY_DSN=your-sentry-dsn
